# --- Flash / partitions ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# --- OTA groundwork ---
# partitions.csv now uses an otadata/ota_0/ota_1 layout instead of a single
# "factory" app partition (see that file's comment for the repartition
# caveat). This alone does not add an update-upload endpoint -- that's a
# separate follow-up -- it just makes the flash layout OTA-capable and,
# combined with this, makes a bad update self-heal: if a newly-flashed OTA
# image never reaches app_main.c's esp_ota_mark_app_valid_cancel_rollback()
# call (e.g. it crash-loops before getting there), the bootloader
# automatically reverts to the previous working ota slot on its own instead
# of bricking the device.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- FreeRTOS / misc ---
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- Wi-Fi ---
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n

# --- Wi-Fi: reduce internal-DRAM footprint (real ESP_ERR_NO_MEM on hardware) ---
# esp_wifi_init()/esp_wifi_start() in combined AP+STA mode allocate their
# RX/TX buffers from internal DRAM -- with the default buffer counts this
# failed outright on real hardware ("wifi:malloc buffer fail", "Expected to
# init 10 rx buffer, actual is 1") once plug_manager.c's own tasks (three
# esp_http_client-capable 12288B-stack tasks -- two of them now deferred
# past Wi-Fi bring-up, see app_main.c/plug_manager.h) plus gpio_inputs.c/
# ac_monitor.c had already claimed their share of the same limited pool --
# combined AP+STA driver buffers alone can run to 60-90KB+ at the defaults.
# These four match Espressif's own documented "Minimum" configuration rank
# for memory-constrained ESP32-S3 apps (see "Wi-Fi Buffer Usage" in the
# ESP-IDF programming guide) -- each buffer is a fixed 1.6KB, so
# default->minimum here alone recovers roughly 90KB. This device's own
# traffic is a handful of small sequential local-LAN HTTP/MQTT requests
# (one plug command or metrics poll at a time, driven by plug_manager.c's
# own single worker/metrics tasks, never many parallel streams), so the
# resulting throughput ceiling (still tens of Mbit/s per Espressif's own
# measurements at this rank) is nowhere near a real constraint here.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=6

# --- HTTP server ---
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_WS_SUPPORT=n

# --- mbedTLS: keep it lean, plain HTTP/MQTT only for now ---
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_HARDWARE_SHA=y

# --- Logging ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- FreeRTOS stack-overflow diagnostics ---
# The default canary check (configCHECK_FOR_STACK_OVERFLOW=2) only verifies
# the last few bytes of a task's stack on each context switch -- a single
# deep call chain that overshoots the canary zone entirely (which is
# exactly what happened: esp_http_client on ESP32-S3 blew well past an
# 8192-byte stack that was fine on classic ESP32) goes undetected until
# something unrelated touches the corrupted memory, surfacing as a
# confusing Guru Meditation panic *inside the FreeRTOS scheduler itself*
# instead of pointing at the actual offending task. This hardware
# watchpoint catches the overflow the instant a write lands in the last 32
# bytes of any task's stack, regardless of how far past that point the
# write would otherwise have gone -- turns any next occurrence into a
# precise panic instead of another one of these to puzzle over.
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y

# --- Reliability: task watchdog actually reboots on trigger ---
# CONFIG_ESP_TASK_WDT_EN/_INIT are already on by default (5s timeout,
# watches both cores' idle tasks) -- but without _PANIC, a trigger only
# prints a warning to the console and the device is left running (or
# rather, stuck) exactly as it was. For a device meant to run unattended
# for a long time, silently limping along is worse than a clean reboot.
# See system_health.c/README for the fuller reliability story, including
# why this alone does NOT catch every hang (it only sees a CPU core being
# hogged, not two tasks deadlocked on each other's mutex while the CPU
# sits idle) -- that gap is covered separately by system_health.c's own
# bounded-wait lock probes.
CONFIG_ESP_TASK_WDT_PANIC=y

# --- LWIP ---
# 16 wasn't enough once net_scan.c started opening several concurrent ping
# sockets on top of the httpd server's own reserved sockets (~7) and AP/STA
# overhead -- esp_ping_new_session() failed with "create socket failed: -1"
# for most of the /24 sweep. See also CONCURRENCY in net_scan.c, which was
# lowered at the same time so a single scan doesn't need this much headroom
# on its own.
CONFIG_LWIP_MAX_SOCKETS=32

# --- ADC ---
# AC mains monitor (ac_monitor.c) is wired to GPIO11, which is ADC2_CH0 --
# physically that's pin 19 on the ESP32-S3-WROOM-1 module, already routed
# on this board's PCB, and the user chose not to re-route it to an ADC1 pin.
# Recent ESP-IDF versions refuse adc_continuous_config() on ADC2 entirely
# on S3/C3 ("ADC2 continuous mode is no longer supported, please use
# ADC1") unless this is set. Known trade-off, accepted deliberately: ADC2
# shares hardware with the Wi-Fi radio, and Wi-Fi is always on on this
# device, so readings can be delayed/noisier while it's active (see the
# runtime warning ac_monitor_init() logs when AC_MON_ADC_UNIT is ADC_UNIT_2).
CONFIG_ADC_CONTINUOUS_FORCE_USE_ADC2_ON_C3_S3=y
