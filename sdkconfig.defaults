# --- Flash / partitions ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# --- FreeRTOS / misc ---
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- Wi-Fi ---
CONFIG_ESP_WIFI_STA_DISCONNECTED_PM_ENABLE=n

# --- HTTP server ---
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_WS_SUPPORT=n

# --- mbedTLS: keep it lean, plain HTTP/MQTT only for now ---
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_HARDWARE_SHA=y

# --- Logging ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- FreeRTOS stack-overflow diagnostics ---
# The default canary check (configCHECK_FOR_STACK_OVERFLOW=2) only verifies
# the last few bytes of a task's stack on each context switch -- a single
# deep call chain that overshoots the canary zone entirely (which is
# exactly what happened: esp_http_client on ESP32-S3 blew well past an
# 8192-byte stack that was fine on classic ESP32) goes undetected until
# something unrelated touches the corrupted memory, surfacing as a
# confusing Guru Meditation panic *inside the FreeRTOS scheduler itself*
# instead of pointing at the actual offending task. This hardware
# watchpoint catches the overflow the instant a write lands in the last 32
# bytes of any task's stack, regardless of how far past that point the
# write would otherwise have gone -- turns any next occurrence into a
# precise panic instead of another one of these to puzzle over.
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y

# --- Reliability: task watchdog actually reboots on trigger ---
# CONFIG_ESP_TASK_WDT_EN/_INIT are already on by default (5s timeout,
# watches both cores' idle tasks) -- but without _PANIC, a trigger only
# prints a warning to the console and the device is left running (or
# rather, stuck) exactly as it was. For a device meant to run unattended
# for a long time, silently limping along is worse than a clean reboot.
# See system_health.c/README for the fuller reliability story, including
# why this alone does NOT catch every hang (it only sees a CPU core being
# hogged, not two tasks deadlocked on each other's mutex while the CPU
# sits idle) -- that gap is covered separately by system_health.c's own
# bounded-wait lock probes.
CONFIG_ESP_TASK_WDT_PANIC=y

# --- LWIP ---
# 16 wasn't enough once net_scan.c started opening several concurrent ping
# sockets on top of the httpd server's own reserved sockets (~7) and AP/STA
# overhead -- esp_ping_new_session() failed with "create socket failed: -1"
# for most of the /24 sweep. See also CONCURRENCY in net_scan.c, which was
# lowered at the same time so a single scan doesn't need this much headroom
# on its own.
CONFIG_LWIP_MAX_SOCKETS=32
