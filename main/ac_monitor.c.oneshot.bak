#include <string.h>
#include <math.h>
#include "sdkconfig.h"
#include "esp_adc/adc_oneshot.h"
#include "esp_adc/adc_cali.h"
#include "esp_adc/adc_cali_scheme.h"
#include "soc/soc_caps.h"
#include "esp_log.h"
#include "esp_timer.h"
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "freertos/semphr.h"
#include "ac_monitor.h"

static const char *TAG = "ac_monitor";

/* ------------------------------------------------------------------ */
/* Wiring / hardware                                                    */
/* ------------------------------------------------------------------ */

/* Which physical GPIO the ZMPT101B output is wired to -- this IS the "AC1"
 * pin (see input_id_t's comment in app_types.h: AC1 has no separate digital
 * line, only this analog one). Configurable via Kconfig (menuconfig ->
 * Smart Plug Control -> AC mains monitor (ZMPT101B)), same pattern as
 * DC1/DC2's GPIOs in Kconfig.projbuild.
 *
 * ESP32-S3 ADC-capable pins split into two independent units: GPIO1-10 =
 * ADC1 (channel = GPIO - 1), GPIO11-20 = ADC2 (channel = GPIO - 11). ADC1
 * is strongly preferred when there's a choice -- ADC2 shares hardware with
 * the Wi-Fi radio and can give delayed/noisier readings while Wi-Fi is
 * active, which on this device is always. CONFIG_AC_MON_ADC_GPIO_DEFAULT
 * resolves to whichever unit/channel its value falls into, at compile time;
 * a build-time #error catches anything outside GPIO1-20.
 *
 * This board's ZMPT101B is wired to GPIO11 (module pin 19, ADC2_CH0),
 * already routed on the PCB -- moving it to an ADC1 pin would mean cutting
 * traces, so that was deliberately not done.
 *
 * SAMPLING BACKEND HISTORY (why this file looks the way it does):
 *  1. adc_continuous (DMA continuous mode) -- the original design. Returned
 *     a frozen, bit-for-bit-identical raw sample across the entire window
 *     on real hardware, even with Wi-Fi fully disabled. Confirmed broken
 *     for this GPIO/unit/chip/IDF combination, abandoned.
 *  2. adc_oneshot, software-paced via vTaskDelay(1) at ~1kHz (20
 *     samples/mains-cycle), raw-count-to-volts via a single linear Kconfig
 *     coefficient. Worked, but two problems showed up on hardware: (a)
 *     vTaskDelay(1) only guarantees "at least one tick" -- with Wi-Fi
 *     active, scheduler/ISR jitter stretched some inter-sample gaps enough
 *     to produce real freq_hz outliers (e.g. 50.13/50.25 Hz spikes against
 *     a steady ~50.00 Hz baseline); fixed by timestamping every sample
 *     (s_window_us[]) and computing frequency from real elapsed time
 *     instead of an assumed fixed sample period. (b) the calibration
 *     constant appeared to drift session over session (0.519 -> 0.500 over
 *     one test run) -- only partially explained by real mains fluctuation.
 *  3. THIS version: still adc_oneshot, but at 5kHz (100 samples/cycle, 5x
 *     denser than step 2) with precise esp_timer_get_time() busy-wait
 *     pacing instead of tick-based vTaskDelay, adc_cali curve-fitting for
 *     raw-count-to-millivolt conversion (uses this chip's own eFuse
 *     calibration data instead of a naive count*3.3/4095 assumption), and
 *     hysteresis on the zero-crossing detector (rejects noise-induced
 *     double-crossings near the mean). Side-by-side comparison on hardware
 *     (same GPIO11/ADC2 pin, Wi-Fi still on) showed this combination
 *     measuring far more stably than step 2 -- strong evidence that most
 *     of what looked like "calibration drift" or "ADC2/Wi-Fi noise" in
 *     step 2 was actually step 2's own measurement methodology (coarse
 *     sampling + tick jitter + no per-chip ADC calibration), not a real
 *     property of the sensor or the Wi-Fi-sharing situation. Re-confirm
 *     this conclusion with a long (15-30 min), no-reflash soak test before
 *     fully trusting it for unattended operation.
 *
 * CONFIG_ADC_CONTINUOUS_FORCE_USE_ADC2_ON_C3_S3 in sdkconfig.defaults is
 * vestigial (step 1 only, long abandoned) but harmless to leave set. */
#define AC_MON_ADC_GPIO CONFIG_AC_MON_ADC_GPIO_DEFAULT

#if AC_MON_ADC_GPIO >= 1 && AC_MON_ADC_GPIO <= 10
#define AC_MON_ADC_UNIT       ADC_UNIT_1
#define AC_MON_ADC_CHANNEL    (AC_MON_ADC_GPIO - 1)
#elif AC_MON_ADC_GPIO >= 11 && AC_MON_ADC_GPIO <= 20
#define AC_MON_ADC_UNIT       ADC_UNIT_2
#define AC_MON_ADC_CHANNEL    (AC_MON_ADC_GPIO - 11)
#else
#error "CONFIG_AC_MON_ADC_GPIO_DEFAULT must be an ADC-capable ESP32-S3 GPIO (1-20)"
#endif

#define AC_MON_ADC_ATTEN    ADC_ATTEN_DB_12  /* full ~0-3.3V input range */
#define AC_MON_ADC_BITWIDTH ADC_BITWIDTH_12  /* explicit, not _DEFAULT -- adc_cali's curve-fitting
                                               * scheme config wants the real width, and this has to
                                               * match the oneshot channel config exactly. */

/* ZMPT101B's own onboard op-amp biases and scales the mains waveform onto
 * this range -- exact gain depends on the module's trim pot, which is why
 * this needs a real calibration pass (see AC_CAL_ENABLE below) rather than
 * a fixed textbook constant.
 *
 * UNITS CHANGED from the previous design: this used to be "volts of mains
 * per raw ADC count". Now that raw counts are converted to real millivolts
 * via adc_cali first (see AC_MON_ADC_BITWIDTH's comment), the coefficient
 * is "volts of mains per millivolt RMS of the ZMPT output". These are
 * numerically different constants for the same physical board -- an old
 * AC_MON_VOLTS_PER_ADC_RMS_COUNT_X10000 value from before this change is
 * NOT valid here, which is why the Kconfig symbol itself was renamed
 * (AC_MON_VOLTS_PER_RMS_MV_X10000) rather than silently reinterpreting the
 * same option -- a stale sdkconfig entry under the old name is now simply
 * ignored instead of quietly feeding the wrong number into this formula.
 * Re-calibrate from scratch after this change.
 *
 * This is board-specific (every physical ZMPT101B module needs its own
 * value), so unlike most other tunables in this project it lives in
 * Kconfig (`menuconfig -> Smart Plug Control -> AC mains monitor
 * (ZMPT101B)`), not the web UI or a plain #define -- same reasoning as the
 * input GPIOs: something you set once per physical build, reflash, and
 * never touch from a phone browser. Kconfig has no float type, so the
 * option is the real coefficient x10000; divided back down here at
 * compile time. */
#define AC_MON_DEFAULT_VOLTS_PER_RMS_MV (CONFIG_AC_MON_VOLTS_PER_RMS_MV_X10000 / 10000.0f)

/* Calibration aid: set to 1, power the board from a known-good AC_CAL_VRMS
 * (read off a multimeter on the real mains line), reflash, watch the log
 * for "CAL: volts_per_rms_mv = ...", multiply that number by 10000 and put
 * it in CONFIG_AC_MON_VOLTS_PER_RMS_MV_X10000 (menuconfig), set this back
 * to 0. Take several readings across a session rather than trusting one --
 * see the sampling-backend-history comment above on why a single reading
 * can be misleading. */
#define AC_CAL_ENABLE 0
#define AC_CAL_VRMS    230.0f

/* Debug aid: set to 1 to stream every processed window's raw + computed
 * numbers to the serial log. Reflash with this back to 0 for normal use --
 * it's one log line every AC_MON_DEBUG_LOG_EVERY_N windows so it's not
 * free but it's not going to flood the log either. Independent of
 * AC_CAL_ENABLE above: that one only prints the derived calibration
 * coefficient, this prints the live reading itself, including the "no
 * mains signal" case that AC_CAL_ENABLE's single log line never reaches. */
#define AC_MON_DEBUG_LOG 1
#define AC_MON_DEBUG_LOG_EVERY_N 10 /* ~2s between lines at the current 200ms window */

/* ------------------------------------------------------------------ */
/* Sampling / processing                                                */
/* ------------------------------------------------------------------ */

/* adc_oneshot, software-paced via precise esp_timer_get_time() busy-wait
 * (not vTaskDelay -- see the sampling-backend-history comment above). */
#define SAMPLE_RATE_HZ       5000
#define SAMPLE_PERIOD_US     (1000000 / SAMPLE_RATE_HZ) /* 200us */
/* 200ms of mains at 5kHz -- ~10 cycles at 50Hz, ~12 at 60Hz, ~100
 * samples/cycle (versus the previous design's ~20/cycle at 1kHz). Shorter
 * window than before (200ms vs 400ms) despite the denser sampling, which
 * is a straight win: faster fault detection (a real mains fault now shows
 * up within ~0.2s instead of ~0.4s) AND better per-cycle resolution. */
#define WINDOW_SAMPLES       1000

/* fill_window()'s capture loop busy-waits almost continuously (each
 * inter-sample gap is only 200us, well under one FreeRTOS tick at
 * CONFIG_FREERTOS_HZ=1000) and this task runs at a real priority (not
 * idle), pinned to one core (see ac_monitor_init()). Without ever
 * voluntarily blocking, that core's idle task would never get scheduled --
 * and this project's Task WDT watches both cores' idle tasks
 * (CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0/1=y) with a 5s PANIC timeout
 * (CONFIG_ESP_TASK_WDT_TIMEOUT_S=5, CONFIG_ESP_TASK_WDT_PANIC=y) -- i.e.
 * this would reset-loop the device within a few seconds of boot if left
 * unaddressed. So every WDT_YIELD_EVERY_N_SAMPLES samples, fill_window()
 * takes one real vTaskDelay(1) instead of busy-waiting, deliberately
 * giving up the core for a tick. This does NOT lose any measurement
 * accuracy: every sample's timestamp is recorded via esp_timer_get_time()
 * regardless of how it was paced, and process_window()'s math uses those
 * real timestamps, not an assumed fixed period -- an occasional longer gap
 * just becomes a correctly-longer interval in the crossing-time math. */
#define WDT_YIELD_EVERY_N_SAMPLES 100 /* ~20ms @ 5kHz -- 10 yields/window, each 1 tick (~1ms): ~5% duty, far under the 5s WDT timeout */

/* Oversampling (ADC_OVERSAMPLE_N back-to-back reads averaged per slot) was
 * tried and removed: on hardware it made the slow vrms drift dramatically
 * worse (rms_mv fell ~19% over a ~150s continuous run, versus a much
 * smaller/slower drift without it) -- most likely because it multiplied
 * ADC activity 4x (20,000 conversions/s instead of 5,000) and kept this
 * core even closer to 100% busy, heating the chip/ADC analog front-end
 * harder and faster than the already-aggressive baseline (no inter-window
 * idle gap -- see ac_monitor_task()). If oversampling is reintroduced
 * later, re-run a long (2-3+ minute) continuous soak test and compare
 * drift rate against a no-oversampling baseline before trusting it. */

/* Below this many millivolts of amplitude (peak-to-peak deviation across
 * the window), treat the line as "just sensor noise/bias, no real mains
 * signal" -- a ZMPT101B with nothing connected still outputs a flat
 * near-constant voltage around its bias point, not a full-scale swing.
 * 40mV is a deliberately generous margin versus the real signal's typical
 * ~1000-1400mV peak-to-peak (see AC_MON_DEBUG_LOG output) -- comfortably
 * above the ADC's own noise floor without risking false "mains present"
 * detections. */
#define NO_MAINS_AMPLITUDE_MV 40.0f

/* Zero-crossing hysteresis, as a fraction of the window's own peak-to-peak
 * amplitude: the signal has to swing at least this far negative before a
 * subsequent rising crossing is accepted, rejecting noise-induced
 * double-crossings right around the mean (which a plain "a<0 && b>=0"
 * check is vulnerable to, especially with real sensor/ADC noise riding on
 * the signal near its zero point). */
#define HYST_FRAC 0.15f

#define MAX_CROSSINGS  64 /* generous headroom over ~10-12 expected per window */

static SemaphoreHandle_t s_lock;
static ac_mon_settings_t s_settings;
static ac_mon_reading_t s_reading;
static float s_volts_per_rms_mv = AC_MON_DEFAULT_VOLTS_PER_RMS_MV;
static ac_mon_change_cb_t s_on_change;
/* Tracks the in_band value last reported to s_on_change, so the callback
 * only fires on an actual transition, not once per window. Starts true
 * (matches process_window()'s own "nothing to protect against yet"
 * default before the first real reading), so plugs aren't gated off
 * during the brief window before the first sample completes. */
static bool s_last_in_band = true;

static adc_oneshot_unit_handle_t s_adc_handle;
static adc_cali_handle_t s_cali_handle;
static uint16_t s_window[WINDOW_SAMPLES];      /* raw ADC counts, as captured */
static int64_t  s_window_us[WINDOW_SAMPLES];   /* esp_timer_get_time() at each sample -- see WDT_YIELD_EVERY_N_SAMPLES's comment on why real timestamps matter here */
static float    s_window_mv[WINDOW_SAMPLES];   /* s_window[] converted through adc_cali, filled once per window in process_window() */

/* Fills s_window[]/s_window_us[] with WINDOW_SAMPLES fresh samples, paced
 * at SAMPLE_RATE_HZ via precise busy-wait (not vTaskDelay -- see
 * SAMPLE_RATE_HZ's comment). Always returns WINDOW_SAMPLES: a single bad
 * adc_oneshot_read() doesn't shrink the window, it just repeats the
 * previous sample (or the ADC's mid-scale bias point for the very first
 * sample) so a transient read failure can't shift the zero-crossing
 * math's sample indices/timing. */
static size_t fill_window(void)
{
    int64_t t0 = esp_timer_get_time();
    for (size_t i = 0; i < WINDOW_SAMPLES; i++) {
        int64_t target = t0 + (int64_t)i * SAMPLE_PERIOD_US;
        while (esp_timer_get_time() < target) { /* busy-wait for precise pacing */ }

        s_window_us[i] = esp_timer_get_time();
        int raw = 0;
        esp_err_t err = adc_oneshot_read(s_adc_handle, AC_MON_ADC_CHANNEL, &raw);
        if (err == ESP_OK) {
            s_window[i] = (uint16_t)raw;
        } else {
            s_window[i] = (i > 0) ? s_window[i - 1] : 2048; /* mid-scale fallback, 12-bit */
        }

        /* See WDT_YIELD_EVERY_N_SAMPLES's comment -- this is required, not
         * an optional tweak, given this task runs pinned to one core at a
         * real priority with the Task WDT watching that core's idle task. */
        if (i > 0 && (i % WDT_YIELD_EVERY_N_SAMPLES) == 0) {
            vTaskDelay(1);
        }
    }
    return WINDOW_SAMPLES;
}

/* Outlier rejection for vrms/freq_hz across consecutive windows: median-of-3,
 * not an EMA. An EMA trades accuracy for smoothness by blending every new
 * reading with the old one, which delays a genuine step change exactly
 * where this module can least afford it (AC1's whole job is noticing a
 * real mains fault promptly). A median instead either passes a value
 * through unchanged (2 of the last 3 windows already agree) or swaps in
 * whichever of the last 3 is the middle one -- a single noisy/outlier
 * window never reaches ac_mon_get_reading() unless the window after it
 * agrees too, but a REAL sustained change still shows up within 2 windows
 * (~0.4s at the current 200ms WINDOW_SAMPLES/SAMPLE_RATE_HZ) -- still
 * inside this module's original "a real fault shows up within half a
 * second" design target. */
#define MEDIAN_HISTORY 3

static float median_of_3(float a, float b, float c)
{
    if (a > b) { float t = a; a = b; b = t; }
    if (b > c) { float t = b; b = c; c = t; }
    if (a > b) { float t = a; a = b; b = t; }
    return b; /* middle element after the two swaps above */
}

/* Runs the RMS + zero-crossing math over s_window[0..n), writes the result
 * into *out. See ac_monitor.h for field meanings. */
static void process_window(size_t n, const ac_mon_settings_t *settings, ac_mon_reading_t *out)
{
    memset(out, 0, sizeof(*out));
    out->updated_us = esp_timer_get_time();

    if (n < WINDOW_SAMPLES / 2) {
        /* Badly short read -- treat like "no reading yet" rather than
         * computing garbage statistics over a half-empty window. With
         * fill_window() above this should never actually happen (it
         * always returns WINDOW_SAMPLES), kept as a defensive guard in
         * case fill_window()'s contract ever changes. */
        out->have_reading = false;
        return;
    }
    out->have_reading = true;

    /* Median-of-3 outlier rejection state for vrms/freq_hz -- see
     * MEDIAN_HISTORY's comment above process_window(). Function-static so
     * it persists across calls (ac_monitor_task calls process_window()
     * from a single context, never concurrently, so plain statics are
     * safe here -- same pattern as crossings_us[] below). */
    static float s_vrms_hist[MEDIAN_HISTORY];
    static float s_freq_hist[MEDIAN_HISTORY];
    static int   s_hist_count = 0; /* saturates at MEDIAN_HISTORY */
    static int   s_hist_next  = 0; /* circular write index */

    /* --- raw counts -> real millivolts, once per window --- */
    for (size_t i = 0; i < n; i++) {
        int mv = 0;
        adc_cali_raw_to_voltage(s_cali_handle, s_window[i], &mv);
        s_window_mv[i] = (float)mv;
    }

    /* --- mean (DC bias) --- */
    double sum = 0;
    for (size_t i = 0; i < n; i++) sum += s_window_mv[i];
    double mean = sum / (double)n;

    /* --- RMS of the AC component + peak-to-peak amplitude --- */
    double sum_sq = 0;
    float min_v = s_window_mv[0], max_v = s_window_mv[0];
    for (size_t i = 0; i < n; i++) {
        double d = (double)s_window_mv[i] - mean;
        sum_sq += d * d;
        if (s_window_mv[i] < min_v) min_v = s_window_mv[i];
        if (s_window_mv[i] > max_v) max_v = s_window_mv[i];
    }
    double rms_mv = sqrt(sum_sq / (double)n);
    float amplitude = max_v - min_v;

    if (amplitude < NO_MAINS_AMPLITUDE_MV) {
        out->mains_present = false;
        out->in_band = true; /* nothing to protect against if there's no signal at all */
        /* Reset the median history so a real reconnection doesn't get its
         * first few post-outage windows blended against stale pre-outage
         * readings -- see MEDIAN_HISTORY's comment. */
        s_hist_count = 0;
        s_hist_next = 0;
#if AC_MON_DEBUG_LOG
        static uint32_t s_debug_no_mains_count = 0;
        if (++s_debug_no_mains_count % AC_MON_DEBUG_LOG_EVERY_N == 0) {
            ESP_LOGI(TAG, "DBG no-mains n=%u min=%.1fmV max=%.1fmV mean=%.1fmV amp=%.1fmV (< %.0fmV threshold)",
                     (unsigned)n, (double)min_v, (double)max_v, mean, (double)amplitude,
                     (double)NO_MAINS_AMPLITUDE_MV);
        }
#endif
        return;
    }
    out->mains_present = true;
    float vrms_raw = (float)(rms_mv * s_volts_per_rms_mv);

    /* --- zero crossings (rising, AC component only, with hysteresis) --- */
    /* Interpolated in REAL microseconds (s_window_us[]), not fractional
     * sample index -- see WDT_YIELD_EVERY_N_SAMPLES's comment on why a
     * fixed-period assumption isn't safe here. The "armed" hysteresis gate
     * mirrors the tested reference implementation: the signal must swing
     * below -hyst before a rising crossing above 0 counts, which rejects
     * noise-induced double-crossings right at the mean. */
    static int64_t crossings_us[MAX_CROSSINGS];
    int n_cross = 0;
    float hyst = HYST_FRAC * amplitude;
    bool armed = false;
    for (size_t i = 1; i < n && n_cross < MAX_CROSSINGS; i++) {
        double xp = (double)s_window_mv[i - 1] - mean;
        double xc = (double)s_window_mv[i] - mean;
        if (xc < -hyst) armed = true;
        if (armed && xp < 0 && xc >= 0) {
            double frac = (xc > xp) ? (-xp / (xc - xp)) : 0.0;
            int64_t dt_us = s_window_us[i] - s_window_us[i - 1];
            crossings_us[n_cross++] = s_window_us[i - 1] + (int64_t)(frac * (double)dt_us);
            armed = false;
        }
    }

    float freq_raw = 0.0f;
    if (n_cross >= 2) {
        int64_t span_us = crossings_us[n_cross - 1] - crossings_us[0];
        if (span_us > 0) {
            freq_raw = (float)((double)(n_cross - 1) * 1000000.0 / (double)span_us);
        }
    }

    /* --- median-of-3 across windows (vrms + freq_hz together, same index,
     * so a rejected/invalid window's slot in one array always lines up
     * with its slot in the other) -- see MEDIAN_HISTORY's comment. Only
     * push into the history when this window actually produced a usable
     * frequency (freq_raw > 0); a window with too few crossings to
     * measure (practically never happens with real mains present, but
     * defensive) is skipped rather than poisoning the median with a 0. */
    if (freq_raw > 0.0f) {
        s_vrms_hist[s_hist_next] = vrms_raw;
        s_freq_hist[s_hist_next] = freq_raw;
        s_hist_next = (s_hist_next + 1) % MEDIAN_HISTORY;
        if (s_hist_count < MEDIAN_HISTORY) s_hist_count++;
    }

    if (s_hist_count == MEDIAN_HISTORY) {
        out->vrms    = median_of_3(s_vrms_hist[0], s_vrms_hist[1], s_vrms_hist[2]);
        out->freq_hz = median_of_3(s_freq_hist[0], s_freq_hist[1], s_freq_hist[2]);
    } else {
        /* Not enough history yet (just started / just recovered from a
         * no-mains gap) -- pass the raw window through unfiltered rather
         * than waiting for 3 windows before reporting anything. */
        out->vrms    = vrms_raw;
        out->freq_hz = freq_raw;
    }

    /* --- in-band check --- */
    /* No more settings->enabled gate here -- AC1's whole purpose is
     * monitoring the mains, so the band check is unconditionally active
     * whenever there's a real reading (freq_hz > 0). */
    if (out->freq_hz <= 0.0f) {
        out->in_band = true;
    } else {
        bool v_ok = (out->vrms >= (float)settings->v_min) && (out->vrms <= (float)settings->v_max);
        bool f_ok = (out->freq_hz >= settings->f_min) && (out->freq_hz <= settings->f_max);
        out->in_band = v_ok && f_ok;
    }

#if AC_CAL_ENABLE
    ESP_LOGW(TAG, "CAL: volts_per_rms_mv = %.5f (at %.1fV RMS, raw rms_mv=%.2f)",
             (double)(AC_CAL_VRMS / (float)rms_mv), (double)AC_CAL_VRMS, rms_mv);
#endif

#if AC_MON_DEBUG_LOG
    static uint32_t s_debug_window_count = 0;
    if (++s_debug_window_count % AC_MON_DEBUG_LOG_EVERY_N == 0) {
        ESP_LOGI(TAG, "DBG n=%u min=%.1fmV max=%.1fmV mean=%.1fmV amp=%.1fmV rms_mv=%.2f "
                      "vrms=%.3fV(raw %.3f) freq=%.3fHz(raw %.3f) n_cross=%d hist=%d/%d mains=%d in_band=%d",
                 (unsigned)n, (double)min_v, (double)max_v, mean, (double)amplitude,
                 rms_mv, (double)out->vrms, (double)vrms_raw, (double)out->freq_hz, (double)freq_raw,
                 n_cross, s_hist_count, MEDIAN_HISTORY,
                 (int)out->mains_present, (int)out->in_band);
    }
#endif
}

static void ac_monitor_task(void *arg)
{
    (void)arg;
    for (;;) {
        size_t n = fill_window();

        ac_mon_settings_t settings_snapshot;
        xSemaphoreTake(s_lock, portMAX_DELAY);
        settings_snapshot = s_settings;
        xSemaphoreGive(s_lock);

        ac_mon_reading_t reading;
        process_window(n, &settings_snapshot, &reading);

        xSemaphoreTake(s_lock, portMAX_DELAY);
        s_reading = reading;
        xSemaphoreGive(s_lock);

        /* Fire the callback outside s_lock (same "network/callout never
         * under s_lock" discipline used everywhere else in this project,
         * even though this particular callback doesn't do network I/O --
         * plug_manager_on_ac_mon_change() takes its own lock and calls
         * enqueue_action(), and nesting locks across modules is exactly the
         * kind of thing that's easy to get wrong later). Only on an actual
         * transition, not every window. */
        if (reading.have_reading && reading.in_band != s_last_in_band) {
            s_last_in_band = reading.in_band;
            if (s_on_change) s_on_change(reading.in_band);
        }
    }
}

esp_err_t ac_monitor_init(const ac_mon_settings_t *settings, ac_mon_change_cb_t on_change)
{
    s_lock = xSemaphoreCreateMutex();
    if (!s_lock) return ESP_ERR_NO_MEM;

    s_settings = *settings;
    memset(&s_reading, 0, sizeof(s_reading));
    s_on_change = on_change;
    s_last_in_band = true;

    adc_oneshot_unit_init_cfg_t unit_cfg = { .unit_id = AC_MON_ADC_UNIT };
    esp_err_t err = adc_oneshot_new_unit(&unit_cfg, &s_adc_handle);
    if (err != ESP_OK) {
        ESP_LOGE(TAG, "adc_oneshot_new_unit failed: %s", esp_err_to_name(err));
        return err;
    }

    adc_oneshot_chan_cfg_t chan_cfg = {
        .atten = AC_MON_ADC_ATTEN,
        .bitwidth = AC_MON_ADC_BITWIDTH,
    };
    err = adc_oneshot_config_channel(s_adc_handle, AC_MON_ADC_CHANNEL, &chan_cfg);
    if (err != ESP_OK) {
        ESP_LOGE(TAG, "adc_oneshot_config_channel failed: %s", esp_err_to_name(err));
        adc_oneshot_del_unit(s_adc_handle);
        s_adc_handle = NULL;
        return err;
    }

    /* Curve-fitting calibration scheme -- uses this specific chip's eFuse
     * ADC calibration data (CONFIG_SOC_ADC_CALIBRATION_V1_SUPPORTED=y on
     * S3) to convert raw counts to real millivolts, instead of assuming a
     * textbook 3.3V/4095-count scale. Not fatal if it fails (falls back to
     * raw counts never being converted -- see the fallback note below),
     * but every vrms reading would then be meaningless, so this really
     * should succeed on any S3. */
    adc_cali_curve_fitting_config_t cali_cfg = {
        .unit_id  = AC_MON_ADC_UNIT,
        .chan     = AC_MON_ADC_CHANNEL,
        .atten    = AC_MON_ADC_ATTEN,
        .bitwidth = AC_MON_ADC_BITWIDTH,
    };
    err = adc_cali_create_scheme_curve_fitting(&cali_cfg, &s_cali_handle);
    if (err != ESP_OK) {
        ESP_LOGE(TAG, "adc_cali_create_scheme_curve_fitting failed: %s -- vrms readings would be "
                      "meaningless without this, refusing to start", esp_err_to_name(err));
        adc_oneshot_del_unit(s_adc_handle);
        s_adc_handle = NULL;
        return err;
    }

    /* Pinned to core 1, not left to float -- fill_window()'s busy-wait
     * capture loop wants to run undisturbed by whatever else the scheduler
     * might otherwise put on the same core mid-window (Wi-Fi's internal
     * tasks default to core 0), and pinning makes that deterministic
     * rather than incidental. See WDT_YIELD_EVERY_N_SAMPLES's comment for
     * why this is still safe for the Task WDT despite the near-continuous
     * busy-wait. 6144: carried over from the original sizing (this
     * project was bitten once by an S3 stack-overflow scheduler panic,
     * see README/task history) -- process_window()'s double-precision
     * math over 1000 samples plus the adc_cali/adc_oneshot driver call
     * chains argue for keeping real headroom. */
    BaseType_t ok = xTaskCreatePinnedToCore(ac_monitor_task, "ac_monitor", 6144, NULL, 4, NULL, 1);
    if (ok != pdPASS) {
        ESP_LOGE(TAG, "failed to start ac_monitor_task");
        adc_cali_delete_scheme_curve_fitting(s_cali_handle);
        s_cali_handle = NULL;
        adc_oneshot_del_unit(s_adc_handle);
        s_adc_handle = NULL;
        return ESP_ERR_NO_MEM;
    }

    /* Runtime check, not #if -- AC_MON_ADC_UNIT/ADC_UNIT_2 are C enum
     * constants, not preprocessor macros, so a #if comparing them would
     * silently evaluate both sides as 0 (any identifier the preprocessor
     * doesn't know is replaced with 0 in a #if) and always take this
     * branch regardless of the actual pin. */
    if (AC_MON_ADC_UNIT == ADC_UNIT_2) {
        ESP_LOGW(TAG, "AC mains monitor on GPIO%d uses ADC2, historically shared with the "
                      "Wi-Fi radio -- on-hardware comparison suggests this matters far less than "
                      "sampling density/timing precision/per-chip calibration did (see the "
                      "sampling-backend-history comment above AC_MON_ADC_GPIO). Still, prefer an "
                      "ADC1 pin (GPIO1-10) on a future board revision if possible.",
                 AC_MON_ADC_GPIO);
    }
    ESP_LOGI(TAG, "AC mains monitor started (GPIO%d, ADC%d_CH%d, adc_oneshot+adc_cali, "
                  "~%d Hz / %d samples per %dms window, pinned to core 1)",
             AC_MON_ADC_GPIO, (AC_MON_ADC_UNIT == ADC_UNIT_1) ? 1 : 2,
             (int)AC_MON_ADC_CHANNEL, SAMPLE_RATE_HZ, WINDOW_SAMPLES,
             (int)(WINDOW_SAMPLES * 1000 / SAMPLE_RATE_HZ));
    return ESP_OK;
}

void ac_monitor_update_settings(const ac_mon_settings_t *settings)
{
    if (!s_lock) return;
    xSemaphoreTake(s_lock, portMAX_DELAY);
    s_settings = *settings;
    xSemaphoreGive(s_lock);
}

void ac_monitor_get_reading(ac_mon_reading_t *out)
{
    if (!out) return;
    if (!s_lock) {
        memset(out, 0, sizeof(*out));
        return;
    }
    xSemaphoreTake(s_lock, portMAX_DELAY);
    *out = s_reading;
    xSemaphoreGive(s_lock);
}
