menu "Smart Plug Control"

    menu "Default trigger input GPIOs"
        comment "Runtime web UI can change enable/disable and invert; these are the physical pin defaults on first boot."

        config INPUT_AC1_GPIO_DEFAULT
            int "AC1 default GPIO"
            default 34
            range 0 39

        config INPUT_DC1_GPIO_DEFAULT
            int "DC1 default GPIO"
            default 35
            range 0 39

        config INPUT_DC2_GPIO_DEFAULT
            int "DC2 default GPIO"
            default 32
            range 0 39
    endmenu

    config WEB_HTTP_PORT
        int "Web UI / REST API HTTP port"
        default 80

    config AP_FALLBACK_SSID_PREFIX
        string "Fallback AP SSID prefix"
        default "SmartPlug-"

    config AP_FALLBACK_PASSWORD
        string "Fallback AP password (min 8 chars)"
        default "plugsetup"

endmenu
